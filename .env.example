# ── Server ────────────────────────────────────────────────────────────────────
PORT=3021

# Public URL of this backend (including sub-path if behind nginx)
HOST=https://api.thecartnova.com/alertflow

# Direct internal URL — used for self-calls inside the server (bypasses nginx)
LOCAL_HOST=http://localhost:3021

# Public URL of the Remix frontend — Shopify redirects here after install
REACT_APP_URL=https://alert-flow-frontend.vercel.app

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/alertflow?retryWrites=true&w=majority

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET_KEY=your_shopify_api_secret_key
SHOPIFY_API_VERSION=2024-01

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
