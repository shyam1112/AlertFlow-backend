# ── Server ────────────────────────────────────────────────────────────────────
PORT=3021
# Public URL of this backend (no trailing slash)
HOST=https://api.yourdomain.com

# Public URL of the Remix frontend (used by Shopify OAuth redirect)
REACT_APP_URL=https://app.yourdomain.com

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/alertflow?retryWrites=true&w=majority

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET_KEY=your_shopify_api_secret_key

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Use a Gmail App Password (not your account password)
# https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
