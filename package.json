{
    "name": "NodeInitSetup",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "NODE_ENV=production node index.js",
        "start:local": "NODE_ENV=local nodemon index.js",
        "start:development": "NODE_ENV=development nodemon index.js",
        "setup": "pm2 deploy ecosystem.config.js production setup",
        "deploy": "pm2 deploy ecosystem.config.js production",
        "setup:dev": "pm2 deploy ecosystem.config.js development setup",
        "deploy:dev": "pm2 deploy ecosystem.config.js development",
        "sync": "NODE_ENV=local node scripts/bulkSync.js",
        "sync:resume": "NODE_ENV=local node scripts/bulkSync.js --resume",
        "sync:dry-run": "NODE_ENV=local node scripts/bulkSync.js --dry-run --limit 10",
        "sync:status": "cat data/sync-state.json 2>/dev/null || echo 'No sync state found'",
        "sync:help": "node scripts/bulkSync.js --help",
        "company-sync": "NODE_ENV=local node scripts/companySyncEntry.js",
        "company-sync:dry-run": "NODE_ENV=local node scripts/companySyncEntry.js --dry-run",
        "customer-sync": "NODE_ENV=local node scripts/customerSyncEntry.js",
        "customer-sync:dry-run": "NODE_ENV=local node scripts/customerSyncEntry.js --dry-run",
        "sync-oracle-account-number": "NODE_ENV=local node scripts/syncOracleAccountNumberEntry.js",
        "sync-oracle-account-number:dry-run": "NODE_ENV=local node scripts/syncOracleAccountNumberEntry.js --dry-run",
        "credit-hold-sync": "NODE_ENV=local node scripts/creditHoldSyncEntry.js",
        "credit-hold-sync:dry-run": "NODE_ENV=local node scripts/creditHoldSyncEntry.js --dry-run"
    },
    "author": "amit",
    "contributors": [],
    "dependencies": {
        "@babel/core": "^7.15.5",
        "@babel/polyfill": "^7.12.1",
        "@babel/preset-env": "^7.15.6",
        "@babel/register": "^7.15.3",
        "axios": "^0.21.4",
        "cookie": "^0.4.1",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "dotenv": "^10.0.0",
        "exceljs": "^4.4.0",
        "express": "^4.17.1",
        "express-xml-bodyparser": "^0.4.1",
        "fs": "^0.0.1-security",
        "jsonwebtoken": "^8.5.1",
        "mongoose": "^6.0.8",
        "morgan": "^1.10.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.10",
        "nonce": "^1.0.4",
        "path": "^0.12.7",
        "winston": "^3.3.3",
        "winston-daily-rotate-file": "^4.5.5"
    },
    "devDependencies": {
        "eslint": "^7.32.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-import": "^2.24.2",
        "eslint-plugin-prettier": "^4.0.0",
        "nodemon": "^3.1.11"
    }
}
